# Segredos das Edge Functions (supabase secrets set --env-file supabase/.env)
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY já são injetados pelo Supabase.

# Chave de API do Asaas (sandbox ou produção)
ASAAS_API_KEY=
# Sandbox (padrão): https://api-sandbox.asaas.com/v3 — produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token compartilhado configurado no webhook do Asaas (gere um valor longo e aleatório)
ASAAS_WEBHOOK_TOKEN=
# Preços em reais (devem espelhar BillingConfig no app)
PRO_PRICE=29.90
FEATURE_PRICE=19.90
