{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "/usr/include/gtk-3.0/**",
        "/usr/include/glib-2.0/**",
        "/usr/lib/x86_64-linux-gnu/glib-2.0/include/**",
        "/usr/include/pango-1.0/**",
        "/usr/include/cairo/**",
        "/usr/include/gdk-pixbuf-2.0/**",
        "/usr/include/atk-1.0/**",
        "/usr/include/harfbuzz/**",
        "/usr/include/x86_64-linux-gnu/**",
        "/usr/include/gio-unix-2.0/**",
        "${workspaceFolder}/linux/flutter/ephemeral/**",
        "${workspaceFolder}/linux/runner/**",
        "${workspaceFolder}/linux/flutter/**"
      ],
      "defines": [
        "APPLICATION_ID=\"com.trabalhei.app\"",
        "GDK_WINDOWING_X11"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c11",
      "cppStandard": "c++14",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
